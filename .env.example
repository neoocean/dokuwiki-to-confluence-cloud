# dokuwiki-to-confluence-cloud — 환경 변수 템플릿
#
# 사용:
#   1) 이 파일을 .secrets/confluence.env 로 복사:
#        mkdir -p .secrets
#        cp .env.example .secrets/confluence.env
#   2) 각 값을 자신의 환경에 맞게 수정 (특히 토큰)
#   3) 매 세션마다 로드:
#        set -a; source .secrets/confluence.env; set +a
#   4) 확인:
#        python run.py wizard --status   # 빈 상태
#        python run.py wizard            # prereq 단계가 모든 값 검증
#
# .secrets/ 디렉터리는 .gitignore / .p4ignore 에 들어가야 함 (커밋 금지).

# ─── Confluence Cloud ────────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://YOUR-DOMAIN.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.org
# https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급
CONFLUENCE_API_TOKEN=ATATT3xFf...
# UI → 공간 설정 → 공간 키 (영문 대문자 권장, 신규 공간 권장)
CONFLUENCE_SPACE_KEY=MIGRATE
# 그 공간에 빈 페이지를 하나 만들고 그 ID. URL 의 pageId=... 또는 ... → 페이지 정보
CONFLUENCE_ROOT_PAGE_ID=123456789

# ─── DokuWiki 원본 ───────────────────────────────────────────────────
# 다음 중 하나의 디렉터리:
#   (a) full install — `doku.php` + `lib/` + `inc/` 가 있는 DokuWiki 설치 루트
#   (b) data-only    — `pages/` + `media/` + `meta/` 만 있는 백업 (DokuWiki
#                      자체는 자동 다운로드해 묶어줌)
# 절대경로 또는 ~/ 사용 가능.
DOKUWIKI_SRC=/path/to/your/dokuwiki/data

# render 단계에서 사용. dev up 으로 컨테이너 띄우면 자동으로 이 값을
# http://127.0.0.1:18080 로 잡아도 된다.
DOKUWIKI_BASE_URL=http://127.0.0.1:18080

# ACL 이 활성화된 라이브 dokuwiki 라면 인증 필요 (dev up 은 ACL off 자동 패치).
# DOKUWIKI_USER=admin
# DOKUWIKI_PASSWORD=

# ─── 옵션 ────────────────────────────────────────────────────────────
# AI vision 비교 (verify build --with-vision)
# ANTHROPIC_API_KEY=

# 과거 리비전 (history) 의 본문 최상단에 박는 revision 메타 헤더 형식.
# 가능: none / panel (기본) / info / note / tip / warning / quote / table / paragraphs
#  panel  - 한 단락 + shift+enter (<br/>) 줄바꿈 (권장)
#  none   - 헤더 박스 생략
#  table  - 2열 표
# 처음 history-convert 시점에 --header-format 으로 지정하면 state.db meta 에 저장됨.
# 이미 업로드된 페이지의 헤더만 새 형식으로 교체하려면:
#   python run.py history-rewrite-headers --header-format panel
